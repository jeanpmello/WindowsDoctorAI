<Window
    x:Class="WindowsDoctorAI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Doctor AI">
    <Grid ColumnDefinitions="220,*">
        <StackPanel Grid.Column="0" Padding="12" Spacing="8">
            <TextBlock Text="Windows Doctor AI" FontSize="18" FontWeight="SemiBold" Margin="4,8,4,12" />
            <Button Content="Inicial" Tag="home" Click="NavigationButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
            <Button Content="Sobre" Tag="about" Click="NavigationButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
            <Button Content="Configurações" Tag="settings" Click="NavigationButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </StackPanel>
        <Frame x:Name="PageFrame" Grid.Column="1" />
    </Grid>
</Window>
