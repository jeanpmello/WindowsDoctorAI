<Window
    x:Class="WindowsDoctorAI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Doctor AI">
    <Grid>
        <StackPanel>
            <TextBlock Text="Windows Doctor AI" />
            <RadioButton x:Name="HomeNavigationButton" Click="NavigationButton_Click" />
            <RadioButton x:Name="AboutNavigationButton" Click="NavigationButton_Click" />
            <RadioButton x:Name="SettingsNavigationButton" Click="NavigationButton_Click" />
            <Frame x:Name="PageFrame" />
        </StackPanel>
    </Grid>
</Window>
