<Page
    x:Class="WindowsDoctorAI.App.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36" Spacing="18" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="Sobre" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Windows Doctor AI" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Aplicativo local para inventário e diagnóstico assistido de computadores Windows. Esta entrega inicial reúne a arquitetura, o dashboard e a coleta somente de leitura." TextWrapping="Wrap" />
            <TextBlock Text="Milestone 1" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="Tecnologias: .NET 9, WinUI 3, MVVM Toolkit, Entity Framework Core e SQLite." TextWrapping="Wrap" />
            <TextBlock Text="O Health Score exibido é temporário e fixo em 95; ele ainda não representa uma avaliação real da saúde do computador. Valores indisponíveis indicam que a API local não forneceu aquela informação." TextWrapping="Wrap" />
            <TextBlock Text="Privacidade: a análise opcional via Ollama envia ao endpoint configurado em loopback o prompt exibido na prévia, que pode incluir achados e orientações ManualOnly únicas com fontes declaradas, não autenticadas. Identificadores conhecidos são redigidos, sem garantia de anonimização completa; o app não controla o serviço Ollama local." TextWrapping="Wrap" />
            <TextBlock Text="Projeto distribuído sob a licença MIT." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
