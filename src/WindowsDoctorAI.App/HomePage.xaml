<Page
    x:Class="WindowsDoctorAI.App.HomePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="InventoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="30,26,30,36" Spacing="20">
            <Border Background="#102B4C" CornerRadius="16" Padding="26">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="Windows Doctor AI" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Uma visão clara para entender o que acontece no seu Windows." TextWrapping="Wrap" Foreground="#D8E5F2" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Border Background="#24476A" CornerRadius="12" Padding="10,5"><TextBlock Text="ANÁLISE LOCAL" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border>
                            <Border Background="#24476A" CornerRadius="12" Padding="10,5"><TextBlock Text="SOMENTE LEITURA" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#193B5E" CornerRadius="12" Padding="16" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="DIAGNÓSTICO LOCAL" FontSize="11" FontWeight="SemiBold" Foreground="#B8D8F4" />
                            <TextBlock Text="Sistema · atualizações · drivers" FontSize="13" Foreground="White" />
                            <TextBlock Text="disco · eventos · backups" FontSize="12" Foreground="#D8E5F2" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}" Padding="14">
                <TextBlock Text="O histórico de diagnósticos é local e opcional: a gravação vem desligada por padrão. Para ativá-la, abra Configurações. Nenhum diagnóstico será salvo enquanto a opção estiver desligada." TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Diagnóstico do computador" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="A coleta é local e somente de leitura. Nenhum reparo será aplicado." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Iniciar Diagnóstico" Command="{Binding StartDiagnosticCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing IsActive="{Binding IsScanning}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="Pontuação de saúde" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding HealthScore}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HealthScoreDescription}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Última execução" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding LastDiagnosticText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}" Padding="18">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LEITURA RÁPIDA" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding DiagnosticBrief}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="COBERTURA DO DIAGNÓSTICO" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding CoverageSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="PRÓXIMO PASSO" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding NextStepSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Análise manual de CBS.log" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Selecione manualmente um CBS.log para uma observação offline independente. Nenhum evento ou atualização será associado; conteúdo lido somente em memória (limite 2 MiB), sem gravação, histórico, exportação ou recomendação." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Selecionar CBS.log e analisar" Command="{Binding AnalyzeCbsLogCommand}" IsEnabled="{Binding CanAnalyzeCbsLog}" />
                        <ProgressRing IsActive="{Binding IsAnalyzingCbsLog}" Width="22" Height="22" />
                    </StackPanel>
                    <TextBlock Text="{Binding CbsLogAnalysisStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CbsLogSource}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CbsLogSignal}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CbsLogDisclaimer}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Versões de backup disponíveis" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="A lista é consultada somente quando você pedir e permanece temporária nesta tela. Exibe apenas ID opaco, data UTC, tipo normalizado e contagem de volumes quando disponível; não inclui nomes, caminhos, host ou arquivos." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Atualizar versões" Command="{Binding RefreshBackupSetCatalogCommand}" />
                        <Button Content="Cancelar consulta" Command="{Binding CancelBackupSetCatalogCommand}" IsEnabled="{Binding IsLoadingBackupSetCatalog}" />
                        <ProgressRing IsActive="{Binding IsLoadingBackupSetCatalog}" Width="22" Height="22" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackupSetCatalogStatusText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding BackupSetCatalogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding VersionId}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{Binding BackupTimeText}" />
                                        <TextBlock Text="{Binding BackupTypeText}" />
                                        <TextBlock Text="{Binding VolumeCountText}" />
                                        <TextBlock Text="{Binding VerificationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="A presença no catálogo não comprova integridade nem recuperabilidade. Esta tela não navega volumes e não oferece restauração." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="6"><TextBlock Text="Problemas críticos" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding CriticalProblemsText}" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="6"><TextBlock Text="Avisos" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding WarningsText}" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="6"><TextBlock Text="Tempo do diagnóstico" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding DiagnosticDurationText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Categorias" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding CategoriesSummary}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Achados e evidências" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding FindingsSummary}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Orientações manuais por achado" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Somente regras ManualOnly são exibidas aqui. São dados declarativos para revisão humana; nenhum comando, elevação, consentimento ou reparo é acionado por esta seção." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ManualGuidanceStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ManualGuidanceFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,4">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding RunReferenceText}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding FindingIdentityText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="{Binding FindingHeading}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="{Binding ProviderText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Recommendations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,4">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{Binding ManualOnlyStatusText}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                            <TextBlock Text="Identidade da regra / versão" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding RuleIdentityText}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding Domain}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding MatchStrengthText}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding MatchExplanation}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding ApplicabilityText}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Aplicabilidade declarada pela regra" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding DeclaredApplicability}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding DeclaredPackageSourceText}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding PackageVersionText}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding PackageSha256Text}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Ação diagnóstica (não executada)" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding DiagnosticAction}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Orientação corretiva para revisão humana (não executada)" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding CorrectiveAction}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding SolutionsDisclosureText}" Style="{StaticResource FieldLabelStyle}" />
                                                            <ItemsControl ItemsSource="{Binding Solutions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding ReferencesDisclosureText}" Style="{StaticResource FieldLabelStyle}" />
                                                            <ItemsControl ItemsSource="{Binding References}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Spacing="2">
                                                                            <HyperlinkButton Content="{Binding Title}" NavigateUri="{Binding HttpsUrl}" HorizontalAlignment="Left" />
                                                                            <TextBlock Text="{Binding HttpsUrl}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="Risco declarado" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding Risk}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Privilégio requerido declarado" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding RequiredPrivilege}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="{Binding ElevationText}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Backup declarado" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding Backup}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Rollback declarado" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding Rollback}" Style="{StaticResource FieldValueStyle}" />
                                                            <TextBlock Text="Limitação declarada da fonte" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Text="{Binding SourceLimitation}" Style="{StaticResource FieldValueStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Candidatos sem evidência suficiente/incompleta" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding IncompleteCandidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="3" Margin="0,4,0,4">
                                                        <TextBlock Text="{Binding RuleIdentityText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding MatchStrengthText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ApplicabilityText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DeclaredPackageSourceText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PackageVersionText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PackageSha256Text}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Plano tipado e consentimento de uso único" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding RepairProposalStatus}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RepairProposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,4">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Proposal.Title}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{Binding Proposal.Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="Tipo" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.Kind}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Versão do plano" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.PlanVersion}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Versão da ação" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.OperationVersion}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Risco" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding RiskText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Impacto declarado" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.Impact}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Alvo" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.Target}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="ID tipado do plano" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.Id}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Execução, achado e regra de origem" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Evidência redigida" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding Proposal.RedactedEvidence}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Pré-condições estruturadas" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding PreconditionsText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Pós-condições estruturadas" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding PostconditionsText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Rollback declarado" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding RollbackSupportText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Pré-condições de rollback" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding RollbackPreconditionsText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="Pós-condições de rollback" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding RollbackPostconditionsText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource FieldValueStyle}" />
                                        <TextBlock Text="SIMULAÇÃO: nenhum comando, reparo ou elevação será executado por esta versão." TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <Button Content="Consinto com este plano exato uma única vez" Command="{Binding DataContext.ConsentToRepairPlanCommand, ElementName=RootPage}" CommandParameter="{Binding}" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Base de conhecimento" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding KnowledgeBaseStatus}" TextWrapping="Wrap" />
                        <Button Content="Selecionar pacote JSON local" Click="ChooseKnowledgePackage_Click" IsEnabled="{Binding CanSelectKnowledgePackage}" />
                        <TextBlock Text="Revisão antes da importação" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Versão" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageVersion}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Fonte declarada (não verificada)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageSource}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Total de regras" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageRuleCount}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="SHA-256 do conteúdo JSON (não comprova autoria)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageSha256}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="{Binding PackageReviewStatus}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Text="O conteúdo é dado declarativo; importação não verifica autoria nem transforma afirmações em fatos. ‘High’ descreve força do match literal, não probabilidade de causa." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <Button Content="Importar pacote revisado" Command="{Binding ImportKnowledgePackageCommand}" IsEnabled="{Binding CanImportKnowledgePackage}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Relatório HTML local" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Gera o relatório da execução atual ou mais recente carregada, com score, evidências diagnósticas e orientações manuais por achado. O arquivo não agrega o histórico de propostas de reparo." TextWrapping="Wrap" />
                        <TextBlock Text="O arquivo é salvo no local escolhido. Conteúdo textual é escapado e o relatório não carrega scripts ou recursos remotos. Revise evidências sensíveis antes de compartilhar." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Gerar e salvar relatório HTML" Click="SaveHtmlReport_Click" IsEnabled="{Binding CanExportHtmlReport}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Assistente de análise local" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Ollama · resposta consultiva · nenhum reparo automático" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="IA OPCIONAL" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Primeiro, teste a instalação com uma frase sintética. Esse teste não envia dados do computador. Para analisar resultados reais, execute o diagnóstico, confira a prévia e escolha Analisar." TextWrapping="Wrap" />
                    <TextBlock Text="Requer Ollama instalado e iniciado, com o modelo llama3.1:8b baixado. A primeira resposta pode demorar. Na análise real, somente o prompt visível na prévia é enviado ao Ollama local; identificadores conhecidos são redigidos, mas isso não garante anonimização completa." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Testar IA sem dados do computador" Command="{Binding TestAiCommand}" IsEnabled="{Binding CanTestAi}" />
                        <Button Content="Analisar diagnóstico" Command="{Binding AnalyzeWithAiCommand}" IsEnabled="{Binding CanAnalyzeWithAi}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Cancelar" Command="{Binding CancelAiAnalysisCommand}" IsEnabled="{Binding IsAiOperationRunning}" />
                        <ProgressRing IsActive="{Binding IsTestingAi}" Width="22" Height="22" />
                        <ProgressRing IsActive="{Binding IsAnalyzingWithAi}" Width="22" Height="22" />
                    </StackPanel>
                    <TextBlock Text="{Binding AiStatusText}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AiAnswerText}" Style="{StaticResource FieldValueStyle}" />
                    <Expander Header="Revisar o texto que será enviado na análise real" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanAnalyzeWithAi}">
                        <TextBox Text="{Binding AiPromptPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" />
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock Text="Informações do computador" Style="{StaticResource SectionTitleStyle}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Computador" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Nome" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding ComputerName}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Fabricante e modelo" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding ManufacturerModel}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Número de série" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding SerialNumber}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Usuário e domínio" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding UserAndDomain}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sistema operacional" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Windows e build" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding OperatingSystem}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Tempo desde a inicialização" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Uptime}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
