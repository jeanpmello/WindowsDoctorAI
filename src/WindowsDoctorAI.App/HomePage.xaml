<Page
    x:Class="WindowsDoctorAI.App.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="InventoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="30,26,30,36" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="Windows Doctor AI" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Diagnóstico, resultados e inventário deste computador" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Diagnóstico do computador" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="A coleta é local e somente de leitura. Nenhum reparo será aplicado." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <Button Content="Iniciar Diagnóstico" Command="{Binding StartDiagnosticCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <ProgressRing IsActive="{Binding IsScanning}" Width="24" Height="24" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" MinWidth="128" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding HealthScore}" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="Health Score" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HealthScoreDescription}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Última execução" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding LastDiagnosticText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Análise manual de CBS.log" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Selecione manualmente um CBS.log para uma observação offline independente. Nenhum evento ou atualização será associado; conteúdo lido somente em memória (limite 2 MiB), sem gravação, histórico, exportação ou recomendação." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Selecionar CBS.log e analisar" Command="{Binding AnalyzeCbsLogCommand}" IsEnabled="{Binding CanAnalyzeCbsLog}" />
                        <ProgressRing IsActive="{Binding IsAnalyzingCbsLog}" Width="22" Height="22" />
                    </StackPanel>
                    <TextBlock Text="{Binding CbsLogAnalysisStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CbsLogSource}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CbsLogSignal}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CbsLogDisclaimer}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InventoryCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Versões de backup disponíveis" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="A lista é consultada somente quando você pedir e permanece temporária nesta tela. Exibe apenas ID opaco, data UTC, tipo normalizado e contagem de volumes quando disponível; não inclui nomes, caminhos, host ou arquivos." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Atualizar versões" Command="{Binding RefreshBackupSetCatalogCommand}" />
                        <Button Content="Cancelar consulta" Command="{Binding CancelBackupSetCatalogCommand}" IsEnabled="{Binding IsLoadingBackupSetCatalog}" />
                        <ProgressRing IsActive="{Binding IsLoadingBackupSetCatalog}" Width="22" Height="22" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackupSetCatalogStatusText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding BackupSetCatalogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding VersionId}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{Binding BackupTimeText}" />
                                        <TextBlock Text="{Binding BackupTypeText}" />
                                        <TextBlock Text="{Binding VolumeCountText}" />
                                        <TextBlock Text="{Binding VerificationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="A presença no catálogo não comprova integridade nem recuperabilidade. Esta tela não navega volumes e não oferece restauração." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="6"><TextBlock Text="Problemas críticos" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding CriticalProblemsText}" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="6"><TextBlock Text="Avisos" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding WarningsText}" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="6"><TextBlock Text="Tempo do diagnóstico" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding DiagnosticDurationText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Categorias" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding CategoriesSummary}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Achados e evidências" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding FindingsSummary}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Base de conhecimento" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding KnowledgeBaseStatus}" TextWrapping="Wrap" />
                        <Button Content="Selecionar pacote JSON local" Click="ChooseKnowledgePackage_Click" IsEnabled="{Binding CanSelectKnowledgePackage}" />
                        <TextBlock Text="Revisão antes da importação" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Versão" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageVersion}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Fonte declarada (não verificada)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageSource}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Total de regras" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageRuleCount}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="SHA-256 do conteúdo JSON (não comprova autoria)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PackageSha256}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="{Binding PackageReviewStatus}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Text="O conteúdo é dado declarativo; importação não verifica autoria nem transforma afirmações em fatos. ‘High’ descreve força do match literal, não probabilidade de causa." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <Button Content="Importar pacote revisado" Command="{Binding ImportKnowledgePackageCommand}" IsEnabled="{Binding CanImportKnowledgePackage}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Relatório HTML local" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Gera o relatório da execução atual ou mais recente carregada, com score, evidências, recomendações disponíveis e histórico de propostas de reparo." TextWrapping="Wrap" />
                        <TextBlock Text="O arquivo é salvo no local escolhido. Conteúdo textual é escapado e o relatório não carrega scripts ou recursos remotos. Revise evidências sensíveis antes de compartilhar." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Gerar e salvar relatório HTML" Click="SaveHtmlReport_Click" IsEnabled="{Binding CanExportHtmlReport}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Informações do computador" Style="{StaticResource SectionTitleStyle}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Computador" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Nome" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding ComputerName}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Fabricante e modelo" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding ManufacturerModel}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Número de série" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding SerialNumber}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Usuário e domínio" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding UserAndDomain}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sistema operacional" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Windows e build" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding OperatingSystem}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Tempo desde a inicialização" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Uptime}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Processador e memória" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="CPU e núcleos" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Processor}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="RAM instalada" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Memory}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="GPU" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Graphics}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Armazenamento" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Volumes e discos locais" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Disks}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Firmware e segurança" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="BIOS" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Bios}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Modo de firmware" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Firmware}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="TPM" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Tpm}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Secure Boot" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding SecureBoot}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InventoryCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Rede" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="IPv4" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding IPv4}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="IPv6" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding IPv6}" Style="{StaticResource FieldValueStyle}" />
                        <TextBlock Text="Adaptadores" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding NetworkAdapters}" Style="{StaticResource FieldValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
